# Copia este archivo como ".env" en la raíz del repo y rellena lo que quieras.
# Todo lo que esté aquí SOBREESCRIBE los valores del código; si no existe .env,
# el bot funciona idéntico con los valores de respaldo (src/config.js y libs).

# Números de owner separados por coma (mismo formato que src/config.js)
# OWNER_NUMBERS=57...,57...

# API de Rule34 (lib/r34flow.js y extras/populate.js)
# R34_API_KEY=...
# R34_USER_ID=...
